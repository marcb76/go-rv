# Ignored files and directories by Docker: it will not be copied from host into the image
# OS Environment specific files to ignore
.DS_Store

# Git and build artifacts
.git
.github
.gitignore
.dockerignore

# Executable and test files
*.exe
*.out
*.test
run.sh

# Documentation files
README.pdf

# SSL certificates
assets/certs/
*.pem
*.key

# Gemini API key
/assets/gemini/gemini_api.key

# MongoDB password
/assets/mongo/db_password
